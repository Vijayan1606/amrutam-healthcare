# =============================================================================
# AMRUTAM HEALTHCARE BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and supply real values (never commit .env)
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://amrutam_user:CHANGE_ME@localhost:5432/amrutam_dev?schema=public

# Test database (separate DB to avoid polluting dev data)
TEST_DATABASE_URL=postgresql://amrutam_user:CHANGE_ME@localhost:5432/amrutam_test?schema=public

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=amrutam-healthcare
JWT_AUDIENCE=amrutam-clients

# --- Password Reset Tokens ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESET_TOKEN_EXPIRES_MINUTES=60

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Encryption (for sensitive fields) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# --- Payment Provider ---
# Set PAYMENT_PROVIDER=dev for development adapter (no real money)
PAYMENT_PROVIDER=dev
# For Razorpay (real): set to razorpay and supply below
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email ---
# Set EMAIL_PROVIDER=console for dev (logs to stdout, no real email)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@amrutam.health

# --- Slot Expiry Job ---
# Minutes before an unpaid slot reservation expires
SLOT_EXPIRY_MINUTES=30
# Interval in ms for running the expiry cleanup job
SLOT_EXPIRY_JOB_INTERVAL_MS=300000

# --- Observability ---
LOG_LEVEL=info
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# --- Security ---
BCRYPT_ROUNDS=12
BODY_LIMIT=1mb
